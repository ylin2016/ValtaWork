# Copy to shared/secrets/.env and fill in. Never commit secrets/ (git-ignored).
# QuickBooks Online app. The OAuth token lives in qbo_tokens.json: Intuit rotates the
# refresh token on every refresh, so keep exactly ONE copy (this folder).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
# Guesty Open API app. Guesty issues at most 5 tokens / 24h for the whole app; every
# project shares the cached token in guesty_token.json — never force a refresh.
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
# Wheelhouse RM API key.
WHEELHOUSE_API_KEY=
