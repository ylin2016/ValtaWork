# Copy to secrets/.env and fill in. Never commit secrets/.env.
# Guesty Open API app (Guesty > Integrations > Open API). Guesty issues at most
# 5 access tokens per 24h per app; the token is cached in secrets/guesty_token.json.
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
# Wheelhouse RM API key (Wheelhouse profile > Api Key > Revenue Management API Keys).
WHEELHOUSE_API_KEY=
